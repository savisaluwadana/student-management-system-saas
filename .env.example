# Database
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/academix

# Authentication
# Use a long, random secret in production (32+ bytes recommended).
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email notifications (optional)
RESEND_API_KEY=replace_with_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# SMS / WhatsApp notifications (optional)
TWILIO_ACCOUNT_SID=replace_with_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_PHONE_NUMBER=replace_with_twilio_phone_number

# Scheduled jobs (optional)
CRON_SECRET=replace_with_a_long_random_secret
